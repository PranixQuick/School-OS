# EdProSys Android release signing — TEMPLATE (safe to commit; contains no secrets).
#
# To sign release builds locally:
#   1. Copy this file to  android/keystore.properties
#      (that path is gitignored and must NEVER be committed)
#   2. Fill in the real values below.
#
# The release build reads these automatically. If android/keystore.properties
# is absent, the release build produces an UNSIGNED bundle instead of failing.

storeFile=C:/path/to/edprosys-upload.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD
